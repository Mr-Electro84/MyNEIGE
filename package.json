{
  "name": "myneige",
  "version": "1.0.1-alpha.1",
  "description": "Pilote Windows pour un acces universitaire via OpenVPN isole",
  "homepage": "https://github.com/Mr-Electro84/MyNEIGE#readme",
  "bugs": {
    "url": "https://github.com/Mr-Electro84/MyNEIGE/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mr-Electro84/MyNEIGE.git"
  },
  "license": "Apache-2.0",
  "author": "Matra DevProd",
  "type": "commonjs",
  "main": "src/main/index.js",
  "scripts": {
    "dist:win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-distribution.ps1",
    "dist:dir": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-distribution.ps1 -SkipInstaller",
    "test:dist": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-distribution.ps1",
    "start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-browser.ps1",
    "credentials:forget": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-browser.ps1 -ForgetCredentials",
    "openvpn:install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/openvpn-setup.ps1 -Install",
    "test:js": "node --test tests/*.test.js",
    "test:cas": "electron tests/cas-electron.cjs",
    "test:browser": "electron tests/browser-features-electron.cjs",
    "test:mail": "electron tests/mail-sso-electron.cjs",
    "test:session": "electron tests/session-lifecycle-electron.cjs",
    "poc:qualify": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/qualify-j1.ps1",
    "poc:analyze": "node scripts/analyze-j1.js",
    "browser:test": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-wfp.ps1 -Elevate -TestCommand browser-test",
    "test:public": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-wfp.ps1 -Elevate -TestCommand public-network-test",
    "poc:build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-poc.ps1",
    "poc:inspect": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-poc.ps1 -Mode inspect",
    "poc:wfp-test": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-wfp.ps1 -Elevate",
    "poc:connect": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-poc.ps1 -Mode connect",
    "test": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-poc.ps1",
    "poc:live": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-live-poc.ps1"
  },
  "devDependencies": {
    "electron": "45.0.0"
  }
}
